{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "QT_QML_GENERATE_QMLLS_INI": "ON"
            }
        },
        {
            "name": "android-base",
            "hidden": true,
            "environment": {
                "QT_ANDROID_KEYSTORE_PATH": "${sourceDir}/configuration/android/rapid-android.jks",
                "QT_ANDROID_KEYSTORE_ALIAS": "rapid-android",
                "QT_ANDROID_KEYSTORE_STORE_PASS": "123456",
                "QT_ANDROID_KEYSTORE_KEY_PASS": "123456"
            },
            "cacheVariables": {
                "ENABLE_TEST": "OFF",
                "ENABLE_ANDROID": "ON",
                "ENABLE_DESKTOP": "OFF"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TEST": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android (arm64-v8a)",
            "inherits": [
                "base",
                "android-base"
            ],
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake"
            }
        },
        {
            "name": "android-x86",
            "displayName": "Android (x86_64)",
            "inherits": [
                "base",
                "android-base"
            ],
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64"
        },
        {
            "name": "android-x86",
            "configurePreset": "android-x86"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
